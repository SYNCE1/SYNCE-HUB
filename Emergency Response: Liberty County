local function newDraw(kind, props)
	local o = Drawing.new(kind)
	for k, v in pairs(props) do o[k] = v end
	return o
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function accumulate(cf, size, b)
	local h = size / 2
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			for sz = -1, 1, 2 do
				local p = Camera:WorldToViewportPoint((cf * CFrame.new(h.X * sx, h.Y * sy, h.Z * sz)).Position)
				if p.Z <= 0 then return false end
				if p.X < b[1] then b[1] = p.X end
				if p.Y < b[2] then b[2] = p.Y end
				if p.X > b[3] then b[3] = p.X end
				if p.Y > b[4] then b[4] = p.Y end
			end
		end
	end
	return true
end

local function bodyBox(char)
	local b = { math.huge, math.huge, -math.huge, -math.huge }
	local n = 0
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			if not accumulate(p.CFrame, p.Size, b) then return nil end
			n += 1
		end
	end
	if n == 0 or b[1] ~= b[1] or b[3] ~= b[3] then return nil end
	return b[1], b[2], b[3], b[4]
end

local function isTeammate(plr)
	return LP.Team ~= nil and plr.Team == LP.Team
end

local function makeEntity()
	return {
		Box = newDraw("Square", { Thickness = 1.5, Filled = false, Visible = false }),
		Name = newDraw("Text", { Size = 14, Center = true, Outline = true, Visible = false }),
		HP = newDraw("Line", { Thickness = 2, Visible = false }),
	}
end
local function hideEntity(e) e.Box.Visible = false; e.Name.Visible = false; e.HP.Visible = false end
local function removeEntity(plr)
	local e = entities[plr]
	if not e then return end
	pcall(function() e.Box:Remove(); e.Name:Remove(); e.HP:Remove() end)
	entities[plr] = nil
end

local fovCircle
if HAS_DRAWING then
	fovCircle = newDraw("Circle", { Thickness = 1, NumSides = 64, Filled = false, Visible = false, Color = Color3.new(1, 1, 1) })
end

local function aimHeld()
	if Config.AimActive then return true end
	return Config.HoldRMB and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

local function onRender()
	if unloaded then return end
	Camera = Workspace.CurrentCamera
	if not Camera or not HAS_DRAWING then return end
	local camPos = Camera.CFrame.Position
	local center = UIS.MouseEnabled and UIS:GetMouseLocation() or (Camera.ViewportSize / 2)
	if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then center = Camera.ViewportSize / 2 end

	fovCircle.Visible = Config.Aim and Config.ShowFOV
	fovCircle.Position = center
	fovCircle.Radius = Config.FOV

	local bestPos, bestDist = nil, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local e = entities[plr]
			if not e then e = makeEntity(); entities[plr] = e end
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
			if not (char and hum and root) or hum.Health <= 0 then
				hideEntity(e)
			else
				local dist = (root.Position - camPos).Magnitude

				-- ESP
				if Config.Enabled and dist <= Config.MaxDistance then
					local x1, y1, x2, y2 = bodyBox(char)
					if x1 then
						local yo = Config.YOffset
						y1 += yo; y2 += yo
						local col = (Config.Team and plr.Team and plr.TeamColor.Color) or Color3.new(1, 1, 1)
						e.Box.Visible = Config.Box
						e.Box.Position = Vector2.new(x1, y1)
						e.Box.Size = Vector2.new(x2 - x1, y2 - y1)
						e.Box.Color = col
						local label = {}
						if Config.Name then table.insert(label, plr.DisplayName) end
						if Config.Team and plr.Team then table.insert(label, "(" .. plr.Team.Name .. ")") end
						if Config.Health then table.insert(label, string.format("%d HP", math.floor(hum.Health))) end
						if Config.Distance then table.insert(label, string.format("[%d st]", math.floor(dist))) end
						e.Name.Visible = #label > 0
						e.Name.Text = table.concat(label, " ")
						e.Name.Position = Vector2.new((x1 + x2) / 2, y1 - 16)
						e.Name.Color = col
						local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						e.HP.Visible = Config.Health
						e.HP.From = Vector2.new(x1 - 4, y2)
						e.HP.To = Vector2.new(x1 - 4, y2 - (y2 - y1) * frac)
						e.HP.Color = Color3.fromRGB(255 * (1 - frac), 255 * frac, 0)
					else
						hideEntity(e)
					end
				else
					hideEntity(e)
				end

				-- aimbot candidate
				if Config.Aim and dist <= Config.AimMax and not (Config.TeamCheck and isTeammate(plr)) then
					local candidates = {}
					local head = char:FindFirstChild("Head")
					local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
					if Config.AimPart == 1 then candidates = { head }
					elseif Config.AimPart == 2 then candidates = { torso }
					else candidates = { head, torso } end
					for _, part in ipairs(candidates) do
						if part and part:IsA("BasePart") then
							local sp, on = Camera:WorldToViewportPoint(part.Position)
							if on and sp.Z > 0 then
								local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
								if d <= Config.FOV and d < bestDist then
									local visible = true
									if Config.VisibleOnly then
										rayParams.FilterDescendantsInstances = { LP.Character, char }
										visible = Workspace:Raycast(camPos, part.Position - camPos, rayParams) == nil
									end
									if visible then bestDist, bestPos = d, part.Position end
								end
							end
						end
					end
				end
			end
		end
	end

	if bestPos and Config.Aim and aimHeld() then
		local k = math.clamp(Config.Smooth, 0.02, 1)
		Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(camPos, bestPos), k)
	end
end

RunService:BindToRenderStep("ERLCEspAim", Enum.RenderPriority.Camera.Value + 1, onRender)
table.insert(connections, Players.PlayerRemoving:Connect(removeEntity))

