local function toggle(text, key)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 28)
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = Enum.Font.Gotham
	b.TextSize = 13
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Parent = list
	corner(b, 8)
	local function refresh()
		b.Text = "  " .. text .. ":  " .. (Config[key] and "ON" or "OFF")
		b.BackgroundColor3 = Config[key] and Color3.fromRGB(40, 80, 160) or PANEL
	end
	refresh()
	b.Activated:Connect(function() Config[key] = not Config[key]; refresh() end)
end

local function cycle(text, key, names)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 28)
	b.BackgroundColor3 = PANEL
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = list
	corner(b, 8)
	local function refresh() b.Text = text .. ": " .. names[Config[key]] end
	refresh()
	b.Activated:Connect(function()
		Config[key] = Config[key] % #names + 1
		refresh()
	end)
end

local activeSlider
local function slider(text, key, min, max, decimals)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 0, 40)
	f.BackgroundColor3 = PANEL
	f.BorderSizePixel = 0
	f.Parent = list
	corner(f, 8)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -10, 0, 18)
	lbl.Position = UDim2.fromOffset(8, 2)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 12
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = f
	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0, 8, 0, 26)
	bar.Size = UDim2.new(1, -16, 0, 6)
	bar.BackgroundColor3 = BG
	bar.BorderSizePixel = 0
	bar.Parent = f
	corner(bar, 3)
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = ACCENT
	fill.BorderSizePixel = 0
	fill.Parent = bar
	corner(fill, 3)
	local mult = 10 ^ (decimals or 0)
	local function set(v)
		v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
		Config[key] = v
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		lbl.Text = text .. ": " .. tostring(v)
	end
	set(Config[key])
	local function fromInput(x)
		set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1))
	end
	f.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			activeSlider = fromInput
			fromInput(i.Position.X)
		end
	end)
end

table.insert(connections, UIS.InputChanged:Connect(function(i)
	if activeSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		activeSlider(i.Position.X)
	end
end))
table.insert(connections, UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		activeSlider = nil
	end
end))

